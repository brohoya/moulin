{
  "name": "moulin",
  "version": "1.0.0",
  "private": true,
  "description": "Dictation from the menu bar with the speech-to-text of your ChatGPT subscription",
  "author": "Bixente Elgart",
  "scripts": {
    "start": "tauri dev",
    "capture": "tauri dev -- -- --capture",
    "sample": "sh scripts/make-sample.sh",
    "icons": "node scripts/make-icons.mjs",
    "e2e": "node scripts/run-e2e.js",
    "e2e:dev": "tauri dev -- -- --e2e",
    "dist": "tauri build",
    "dist:mac": "tauri build --bundles app,dmg",
    "dist:win": "tauri build --bundles nsis",
    "dist:linux": "tauri build --bundles appimage",
    "signing:setup": "sh scripts/signing-setup.sh",
    "reinstall": "sh scripts/reinstall-mac.sh"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tauri-apps/cli": "2.12.4"
  }
}
