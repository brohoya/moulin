{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "The settings window.",
  "windows": ["settings"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-settings-get",
    "allow-settings-set",
    "allow-settings-capture",
    "allow-account-sign-in",
    "allow-account-sign-out",
    "allow-open-accessibility",
    "allow-microphones"
  ]
}
